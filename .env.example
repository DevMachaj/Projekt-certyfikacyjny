SUPABASE_URL=###
SUPABASE_KEY=###
# Supabase project service-role key. Server-only — bypasses RLS, used for account deletion
# (auth.admin.deleteUser). Provision as a Cloudflare Worker secret in production; never commit a value.
SUPABASE_SERVICE_ROLE_KEY=###
ANTHROPIC_API_KEY=###
# Playwright E2E only. Optional — e2e/auth.setup.ts defaults to a shared local user and creates
# it on first run. Override to point the suite at a non-local target.
# E2E_EMAIL=e2e@example.com
# E2E_PASSWORD=e2e-local-password
# E2E_BASE_URL=http://localhost:4321