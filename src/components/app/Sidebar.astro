---
import Icon from "@/components/app/Icon.astro";

interface Props {
  // Resolved nav key for the current route: "dashboard" | "products" | "plan" | null (none).
  active?: string | null;
  email: string;
  understockedCount?: number;
}

const { active = null, email, understockedCount = 0 } = Astro.props;

// Initials for the account avatar, derived from the email local-part (no store-name concept).
const localPart = email.split("@")[0] ?? "";
const letters = localPart.replace(/[^a-zA-Z]/g, "");
const initials = (letters.slice(0, 2) || email.slice(0, 2) || "?").toUpperCase();

const navBase = "flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium transition-colors";
const navActive = "bg-[var(--accent-subtle)] text-[var(--accent-subtle-fg)]";
const navIdle = "text-muted-foreground hover:bg-[var(--surface-sunken)]";
---

<aside
  class="border-border sticky top-0 flex h-screen w-[var(--sidebar-w)] flex-shrink-0 flex-col border-r bg-[var(--surface)] px-3.5 py-[18px]"
>
  <div class="px-1.5 pt-0.5 pb-5">
    <div class="flex items-center gap-2.5">
      <div class="bg-primary flex size-7 items-center justify-center rounded-lg text-white">
        <Icon icon="boxes" size={17} />
      </div>
      <span class="text-[length:var(--fs-lg)] font-bold tracking-[var(--track-snug)] text-[var(--text-heading)]">
        StockHelper
      </span>
    </div>
  </div>

  <nav class="flex flex-col gap-[3px]">
    <a href="/dashboard" class:list={[navBase, active === "dashboard" ? navActive : navIdle]}>
      <Icon icon="dashboard" size={17} />
      <span class="flex-1">Dashboard</span>
    </a>
    <a href="/products" class:list={[navBase, active === "products" ? navActive : navIdle]}>
      <Icon icon="package" size={17} />
      <span class="flex-1">Produkty</span>
    </a>
    <a href="/plan" class:list={[navBase, active === "plan" ? navActive : navIdle]}>
      <Icon icon="clipboard" size={17} />
      <span class="flex-1">Plan zatowarowania</span>
      {
        understockedCount > 0 && (
          <span class="border-status-under-border bg-status-under-bg text-status-under-fg rounded-full border px-[7px] font-mono text-[11px] leading-[17px] font-semibold">
            {understockedCount}
          </span>
        )
      }
    </a>
  </nav>

  <div class="border-border mt-auto border-t pt-2.5">
    <a
      href="/account"
      class="flex items-center gap-2.5 rounded-md px-1.5 py-2 transition-colors hover:bg-[var(--surface-sunken)]"
    >
      <div
        class="flex size-[30px] flex-shrink-0 items-center justify-center rounded-full bg-[var(--indigo-100)] text-xs font-semibold text-[var(--indigo-700)]"
      >
        {initials}
      </div>
      <div class="min-w-0">
        <div class="text-foreground truncate text-sm font-medium">{email}</div>
      </div>
    </a>
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="text-muted-foreground mt-1 w-full rounded-md px-1.5 py-1.5 text-left text-sm transition-colors hover:bg-[var(--surface-sunken)]"
      >
        Wyloguj
      </button>
    </form>
  </div>
</aside>
