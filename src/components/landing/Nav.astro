---
import Wordmark from "@/components/landing/Wordmark.astro";
import Icon from "@/components/landing/Icon.astro";
import { buttonVariants } from "@/components/ui/button";
---

<header
  class="border-border sticky top-0 z-10 border-b bg-[color-mix(in_oklch,var(--surface)_82%,transparent)] backdrop-blur-[10px]"
>
  <div class="mx-auto flex h-16 max-w-[var(--container)] items-center justify-between px-8">
    <Wordmark />
    <div class="flex items-center gap-2.5">
      <a href="/auth/signin" class:list={buttonVariants({ variant: "ghost", size: "sm" })}>Zaloguj</a>
      <a href="/auth/signup" class:list={buttonVariants({ variant: "default", size: "sm" })}>
        Zarejestruj się
        <Icon icon="arrow-right" size={15} />
      </a>
    </div>
  </div>
</header>
