---
import { recommendationText, type ClassificationResult } from "@/lib/classification";
import { Badge } from "@/components/ui/badge";
import type { Product } from "@/types";

interface Props {
  product: Product;
  classification: ClassificationResult;
}

const { product, classification } = Astro.props;
const action = recommendationText(classification.recommendation, classification.state);
---

<a
  href={`/products/${product.id}`}
  class="group border-border bg-card text-card-foreground flex flex-col gap-3 rounded-lg border p-5 shadow-[var(--ds-shadow-sm)] transition-all hover:border-[var(--border-strong)] hover:shadow-[var(--ds-shadow-md)]"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="font-semibold">{product.name}</h3>
    <Badge state={classification.state} />
  </div>
  <p class="text-muted-foreground text-sm">{action}</p>
</a>
