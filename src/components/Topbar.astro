---
const { user } = Astro.locals;
---

<div
  class="border-border bg-card text-card-foreground mb-4 flex items-center justify-between rounded-lg border px-4 py-2 text-sm shadow-[var(--ds-shadow-sm)]"
>
  {
    user ? (
      <>
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <a
            href="/dashboard"
            class="text-[var(--link)] transition-colors hover:text-[var(--link-hover)] hover:underline"
          >
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="text-[var(--link)] transition-colors hover:text-[var(--link-hover)] hover:underline"
            >
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex gap-3">
          <a
            href="/auth/signin"
            class="text-[var(--link)] transition-colors hover:text-[var(--link-hover)] hover:underline"
          >
            Sign in
          </a>
          <a
            href="/auth/signup"
            class="text-[var(--link)] transition-colors hover:text-[var(--link-hover)] hover:underline"
          >
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
