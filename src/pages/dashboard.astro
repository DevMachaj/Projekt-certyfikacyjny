---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/dashboard/ProductCard.astro";
import { createClient } from "@/lib/supabase";
import { getProductsByUser, getSalesEntriesByUser } from "@/lib/db";
import { classifyUserCatalog, groupProductsByState } from "@/lib/dashboard";

const { user } = Astro.locals;

// Middleware guards /dashboard, so `user` is present. `createClient` can still return null when
// Supabase env is unset. Two batch queries (products + all sales entries), then classify in memory
// — no per-product query loop (the roadmap's named N+1 risk). RLS scopes both queries by user.
const supabase = createClient(Astro.request.headers, Astro.cookies);

let groups: ReturnType<typeof groupProductsByState> = [];

if (supabase && user) {
  try {
    const products = await getProductsByUser(supabase, user.id);
    const entries = await getSalesEntriesByUser(supabase, user.id);

    // `products` is already name-sorted by getProductsByUser, so within-group order is alphabetical.
    groups = groupProductsByState(classifyUserCatalog(products, entries));
  } catch {
    // Degrade to the empty state rather than 500-ing the page (e.g. transient DB error or
    // a missing remote migration). `groups` stays [].
    groups = [];
  }
}

const hasProducts = groups.length > 0;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen px-4 py-10">
    <div class="mx-auto w-full max-w-4xl">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Dashboard
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">
            Signed in as <span class="font-medium text-blue-100/80">{user?.email}</span>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/products"
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            Manage products
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>
      </header>

      {
        hasProducts ? (
          <div class="space-y-8">
            {groups.map((group) => (
              <section>
                <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/70 uppercase">{group.state}</h2>
                <div class="grid gap-3 sm:grid-cols-2">
                  {group.items.map((item) => (
                    <ProductCard product={item.product} classification={item.classification} />
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-12 text-center">
            <p class="mb-1 text-lg font-medium text-white">No products yet</p>
            <p class="mb-6 text-sm text-blue-100/60">
              Add your first product to start tracking its stock health and reorder timing.
            </p>
            <a
              href="/products"
              class="inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Add your first product
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>
