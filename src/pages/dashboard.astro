---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/dashboard/ProductCard.astro";
import { RestockingPlan } from "@/components/dashboard/RestockingPlan";
import { buttonVariants } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { getProductsByUser, getSalesEntriesByUser } from "@/lib/db";
import { classifyUserCatalog, groupProductsByState } from "@/lib/dashboard";

const { user } = Astro.locals;

// Middleware guards /dashboard, so `user` is present. `createClient` can still return null when
// Supabase env is unset. Two batch queries (products + all sales entries), then classify in memory
// — no per-product query loop (the roadmap's named N+1 risk). RLS scopes both queries by user.
const supabase = createClient(Astro.request.headers, Astro.cookies);

let groups: ReturnType<typeof groupProductsByState> = [];

if (supabase && user) {
  try {
    const products = await getProductsByUser(supabase, user.id);
    const entries = await getSalesEntriesByUser(supabase, user.id);

    // `products` is already name-sorted by getProductsByUser, so within-group order is alphabetical.
    groups = groupProductsByState(classifyUserCatalog(products, entries));
  } catch {
    // Degrade to the empty state rather than 500-ing the page (e.g. transient DB error or
    // a missing remote migration). `groups` stays [].
    groups = [];
  }
}

const hasProducts = groups.length > 0;
---

<Layout title="Dashboard">
  <div class="bg-background min-h-screen px-4 py-10">
    <div class="mx-auto w-full max-w-4xl">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-foreground text-3xl font-bold tracking-tight">Dashboard</h1>
          <p class="text-muted-foreground mt-1 text-sm">
            Signed in as <span class="text-foreground font-medium">{user?.email}</span>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/products" class:list={buttonVariants({ variant: "default" })}>Manage products</a>
          <a href="/account" class:list={buttonVariants({ variant: "outline" })}>Account</a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={buttonVariants({ variant: "outline" })}>Sign out</button>
          </form>
        </div>
      </header>

      <RestockingPlan client:load />

      {
        hasProducts ? (
          <div class="space-y-8">
            {groups.map((group) => (
              <section>
                <h2 class="text-muted-foreground mb-3 text-sm font-semibold tracking-wide uppercase">{group.state}</h2>
                <div class="grid gap-3 sm:grid-cols-2">
                  {group.items.map((item) => (
                    <ProductCard product={item.product} classification={item.classification} />
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="border-border bg-card text-card-foreground rounded-lg border p-12 text-center shadow-[var(--ds-shadow-sm)]">
            <p class="text-foreground mb-1 text-lg font-medium">No products yet</p>
            <p class="text-muted-foreground mb-6 text-sm">
              Add your first product to start tracking its stock health and reorder timing.
            </p>
            <a href="/products" class:list={buttonVariants({ variant: "default" })}>
              Add your first product
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>
