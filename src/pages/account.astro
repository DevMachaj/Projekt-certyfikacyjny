---
import Layout from "@/layouts/Layout.astro";
import { AccountDangerZone } from "@/components/account/AccountDangerZone";

const { user } = Astro.locals;

// Middleware guards /account, so `user` is present. `user.email` is typed `string | undefined`
// (Supabase) and lint is type-checked, so resolve a definite string before passing it down.
const email = user?.email ?? "";
---

<Layout title="Account">
  <div class="bg-background min-h-screen px-4 py-10">
    <div class="mx-auto w-full max-w-3xl">
      <header class="mb-8">
        <h1 class="text-foreground text-3xl font-bold tracking-tight">Account</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          Signed in as <span class="text-foreground font-medium">{email}</span>
        </p>
      </header>

      <AccountDangerZone client:load email={email} />
    </div>
  </div>
</Layout>
