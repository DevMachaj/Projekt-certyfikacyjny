---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div
      class="border-border bg-card text-card-foreground w-full max-w-sm rounded-lg border p-8 shadow-[var(--ds-shadow-lg)]"
    >
      <h1 class="text-foreground mb-6 text-center text-2xl font-bold tracking-tight">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-[var(--link)] hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
